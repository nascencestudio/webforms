{
  "name": "@nascencestudio/webforms",
  "version": "0.1.0",
  "description": "Forms for StudioCMS sites: built in the dashboard, submissions stored and emailed, spam stopped in layers without third parties",
  "license": "MIT",
  "author": "Nascence Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nascencestudio/webforms.git"
  },
  "homepage": "https://github.com/nascencestudio/webforms#readme",
  "bugs": {
    "url": "https://github.com/nascencestudio/webforms/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "patches"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Webform.astro": "./dist/runtime/Webform.astro",
    "./tapestry": {
      "types": "./dist/tapestry.d.ts",
      "default": "./dist/tapestry.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@nascencestudio/ipguard": "^0.1.0",
    "@nascencestudio/tapestry": "^0.7.0",
    "astro": "^7.0.0",
    "studiocms": "^0.6.0 || ^0.7.0"
  },
  "peerDependenciesMeta": {
    "@nascencestudio/ipguard": {
      "optional": true
    },
    "@nascencestudio/tapestry": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@nascencestudio/ipguard": "0.1.0",
    "@nascencestudio/tapestry": "0.7.0",
    "@types/node": "22.20.4",
    "astro": "7.4.1",
    "studiocms": "0.7.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "astro",
    "studiocms",
    "studiocms-plugin",
    "forms",
    "webform",
    "contact-form",
    "spam-protection",
    "captcha-alternative"
  ],
  "packageManager": "pnpm@12.4.2"
}
